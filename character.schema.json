{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Noctis Character v0.3",
  "type": "object",
  "required": [
    "id",
    "name",
    "chats"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "personality": {
      "type": "string"
    },
    "backstory": {
      "type": "string"
    },
    "voice": {
      "type": "string"
    },
    "directives": {
      "type": "string"
    },
    "permanentMemory": {
      "type": "string"
    },
    "lore": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        }
      }
    },
    "chats": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "activeChatId": {
      "type": "string"
    }
  }
}